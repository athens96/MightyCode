<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app under the hardened runtime (required for notarization). No JIT: no
  browser engine runs in this process (the page's WKWebView runs out of process,
  and there is no in-app browser).
  - automation.apple-events, device.audio-input, device.camera: the app is a
    terminal. macOS asks the responsible app when a command run in a pane
    (osascript, a CLI that records audio or video) needs one of these, and under
    the hardened runtime it refuses without asking unless the app holds the
    entitlement. The prompts name the reason from Info.plist. Ghostty and iTerm2
    ship the same three.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
