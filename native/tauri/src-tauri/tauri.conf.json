{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mighty Code",
  "mainBinaryName": "MightyCode",
  "identifier": "dev.mightycode.native",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../windows/web/dist-tauri",
    "beforeDevCommand": { "script": "npm run dev -- --mode tauri --strictPort", "cwd": "../../windows/web" },
    "beforeBuildCommand": { "script": "npm run build -- --mode tauri", "cwd": "../../windows/web" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src http://*.html.mighty.invalid mightyhtml:; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": { "../../../assets/pets/": "pets/" },
    "icon": ["../../../assets/icons/MightyCode.ico", "../../../assets/icons/mightycode.png", "../../../assets/icons/MightyCode.icns"]
  }
}
